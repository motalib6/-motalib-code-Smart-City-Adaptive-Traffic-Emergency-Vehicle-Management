# Copy to .env for local overrides (never commit real secrets).
SMARTFLOW_JWT_SECRET=dev-only-change-me
SMARTFLOW_ADMIN_EMAIL=admin@smartflow.local
SMARTFLOW_ADMIN_PASSWORD=ChangeMe123!
# SMARTFLOW_DATABASE_URL=sqlite:///./data/smartflow.db

# SUMO configuration
SUMO_HOME="C:\Program Files (x86)\SUMO"
SUMO_BINARY="C:\Program Files (x86)\SUMO\bin\sumo.exe"
SUMO_GUI_BINARY="C:\Program Files (x86)\SUMO\bin\sumo-gui.exe"
SUMO_CONFIG="simulation/sumo/config/smartflow.sumocfg"

SIMULATION_MODE=sumo
SUMO_GUI_ENABLED=false
