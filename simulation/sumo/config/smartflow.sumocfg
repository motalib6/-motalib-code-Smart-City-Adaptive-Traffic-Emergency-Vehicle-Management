<?xml version="1.0" encoding="UTF-8"?>
<!-- SMARTFLOW ODISHA — SUMO configuration. Build the .net.xml first:
     python simulation/sumo/build_network.py   (requires SUMO on PATH) -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
  <input>
    <net-file value="../network/smartflow.net.xml"/>
    <route-files value="../routes/smartflow.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
    <step-length value="1.0"/>
  </time>
  <processing>
    <time-to-teleport value="-1"/>
  </processing>
</configuration>
